# Server Configuration
PORT=8001
HOST=0.0.0.0
ALLOWED_ORIGINS=*

# Security
JWT_SECRET_KEY=generate_a_secure_random_key_here
JWT_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL with pgvector for production; SQLite for local testing)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/qwickcall
SYNC_DATABASE_URL=postgresql://user:password@localhost:5432/qwickcall

# Groq API Key (Primary LLM Engine - Free tier at console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key (Tier-2 Fallback LLM Engine)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# ElevenLabs API Key (Optional TTS - Free trial at elevenlabs.io. If empty, falls back to Edge-TTS)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM  # Default voice: Rachel

# Deepgram API Key (Optional STT - Free trial at console.deepgram.com)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Exotel Configuration (For Indian Enterprise Telephony - exotel.com)
EXOTEL_ACCOUNT_SID=your_exotel_account_sid_here
EXOTEL_API_KEY=your_exotel_api_key_here
EXOTEL_API_TOKEN=your_exotel_api_token_here
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_CALLER_ID=+911140840000  # Your Exotel provisioned Indian DID / 160-series
EXOTEL_APP_ID=your_voicebot_app_id_here
DEFAULT_ESCALATION_NUMBER=+919876543210

# Environment Mode ('development', 'testing', 'production')
ENVIRONMENT=development

# TTS Configuration (deepgram for development/testing, sarvam for production)
TTS_ENGINE=deepgram  # Options: deepgram (dev/test), sarvam (production), elevenlabs, edge-tts
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_SPEAKER=ritu
SARVAM_MODEL=bulbul:v3
SARVAM_LANGUAGE_CODE=en-IN
DEEPGRAM_VOICE_MODEL=aura-asteria-en  # Options: aura-asteria-en, aura-luna-en, aura-stella-en
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Base URL for Webhooks (e.g. https://your-app.trycloudflare.com or public domain)
BASE_URL=http://localhost:8001

# Office Calling Room Acoustic Presence (Simulates live admissions office desk presence & subtle room reflection)
ENABLE_OFFICE_ACOUSTICS=false
OFFICE_ACOUSTICS_WET=0.0

# Headset Microphone & Admissions Office Floor Ambience (Background counselor chatter + typing)
ENABLE_HEADSET_OFFICE_SOUND=false
OFFICE_AMBIENCE_LEVEL=0.0

# Messaging & Brochure Dispatch (WhatsApp & Email)
WHATSAPP_PROVIDER=mock  # Options: mock, meta, twilio
WHATSAPP_META_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886

EMAIL_PROVIDER=mock  # Options: mock, smtp, sendgrid
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=admissions@idigitalstudies.com
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=admissions@idigitalstudies.com

DEFAULT_BROCHURE_URL=https://idigitalstudies.com/assets/brochure.pdf
DEFAULT_BROCHURE_TITLE="Course Curriculum & Information Brochure"

# Conversational Fillers Toggle (false = direct sub-400ms streaming without artificial filler prefixes)
ENABLE_CONVERSATIONAL_FILLERS=false


# -----------------------------------------------------------------------------
# Security (required in production)
# -----------------------------------------------------------------------------
# JWT_SECRET_KEY (above) must be a random value of 32+ characters:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
# Platform owner login. No default: leave unset to disable env-based owner login.
ADMIN_EMAIL=admin@qwickcall.ai
# ADMIN_PASSWORD=
# Key for encrypting tenant Exotel tokens / SMTP passwords at rest (defaults to a key derived from JWT_SECRET_KEY)
# SECRETS_ENCRYPTION_KEY=
# Shared secret for Exotel. When set, append ?token=<value> to every Exotel applet URL
# (voicebot-connect, passthru, status, transfer-callback, and the wss:// media-stream URL).
# EXOTEL_WEBHOOK_TOKEN=
# Meta WhatsApp: verify token for the GET handshake and the app secret for X-Hub-Signature-256
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# Hard cap on a single call's length in seconds
MAX_CALL_DURATION_SECONDS=900
# Verify the Asterisk WSS certificate (only disable for a self-signed lab PBX)
RPDIGITAL_SIP_TLS_VERIFY=true
